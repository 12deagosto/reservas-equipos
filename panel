<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Preparación de Equipos · Sala de Computación</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
  /* Misma identidad visual que reservas-edutec.html (valores copiados, ese archivo no se tocó) */
  :root{
    --paper:#F2F4EE;
    --card:#FFFFFF;
    --ink:#1F2A24;
    --ink-soft:#5B6B60;
    --pine:#2F4B3C;
    --pine-soft:#3F6350;
    --chalk:#E3A72F;
    --chalk-soft:#F3D889;
    --brick:#A6432D;
    --brick-soft:#F4DFD8;
    --line:#DCE1D8;
    --radius:14px;
    --warn-amarillo:#E3B93A;
    --warn-amarillo-bg:#FBF1D3;
    --warn-naranja:#D97B2B;
    --warn-naranja-bg:#FBE3CD;
    --verde-bg:#E7F0E2;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:'Inter',system-ui,sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  .wrap{max-width:640px;margin:0 auto;padding:22px 18px 60px;}

  header{margin-bottom:18px;}
  .brand-eyebrow{
    font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.12em;text-transform:uppercase;
    color:var(--pine-soft);font-weight:600;margin:0 0 4px;
  }
  h1{font-family:'Fraunces',serif;font-size:clamp(22px,5vw,28px);font-weight:600;margin:0;color:var(--pine);letter-spacing:-0.01em;}
  .reloj{font-family:'IBM Plex Mono',monospace;font-size:13px;color:var(--ink-soft);margin-top:4px;}

  /* Tarjeta principal: próxima entrega */
  .principal{
    background:var(--card);border:2px solid var(--line);border-radius:var(--radius);
    padding:24px 22px;margin-bottom:18px;transition:background .3s,border-color .3s;
  }
  .principal.amarillo{background:var(--warn-amarillo-bg);border-color:var(--warn-amarillo);}
  .principal.naranja{background:var(--warn-naranja-bg);border-color:var(--warn-naranja);}
  .principal.rojo{background:var(--brick-soft);border-color:var(--brick);}
  .principal.verde{background:var(--verde-bg);border-color:var(--pine-soft);}

  .principal .etiqueta{
    font-family:'IBM Plex Mono',monospace;font-size:12.5px;letter-spacing:.1em;text-transform:uppercase;
    color:var(--ink-soft);font-weight:700;margin-bottom:14px;
  }

  .principal dl{display:grid;grid-template-columns:auto 1fr;gap:6px 16px;margin:0 0 18px;}
  .principal dt{font-size:12px;text-transform:uppercase;letter-spacing:.05em;color:var(--ink-soft);font-weight:700;align-self:start;padding-top:3px;}
  .principal dd{margin:0;font-family:'Fraunces',serif;font-size:clamp(19px,5vw,24px);font-weight:600;color:var(--ink);}

  .contador{text-align:center;margin:18px 0;padding:14px 0;border-top:1px solid rgba(0,0,0,.06);border-bottom:1px solid rgba(0,0,0,.06);}
  .contador .etiqueta-contador{font-size:14px;font-weight:600;color:var(--ink-soft);}
  .contador .num{
    font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:clamp(46px,15vw,64px);
    line-height:1.05;color:var(--pine);
  }
  .principal.amarillo .num{color:#7A5C10;}
  .principal.naranja .num{color:var(--warn-naranja);}
  .principal.rojo .num{color:var(--brick);}
  .principal.verde .num{color:var(--pine-soft);}
  .contador .unidad{font-size:15px;color:var(--ink-soft);font-weight:600;}

  .preparar-titulo{font-size:12px;text-transform:uppercase;letter-spacing:.05em;color:var(--ink-soft);font-weight:700;margin:0 0 8px;}
  .preparar-lista{list-style:none;margin:0 0 18px;padding:0;font-size:17px;font-weight:600;line-height:1.9;}
  .preparar-lista li{color:var(--ink);}

  .preparacion-box{background:rgba(0,0,0,.03);border-radius:10px;padding:12px 14px;margin-bottom:18px;}
  .preparacion-box .preparar-titulo{margin-bottom:6px;}
  .check-item{display:flex;align-items:center;gap:9px;padding:6px 2px;font-size:15px;cursor:pointer;user-select:none;}
  .check-item input{width:19px;height:19px;flex-shrink:0;accent-color:var(--pine);}
  .check-item.marcado span{text-decoration:line-through;color:var(--ink-soft);}

  .confirmacion-preparado{
    background:var(--verde-bg);border:1px solid var(--pine-soft);border-radius:10px;
    padding:12px 14px;margin-bottom:16px;font-size:15px;font-weight:600;color:var(--pine);text-align:center;
  }

  .btn-preparado{
    width:100%;border:none;border-radius:12px;padding:18px 16px;
    font-size:18px;font-weight:700;color:#fff;background:var(--pine);cursor:pointer;
    font-family:'Inter',sans-serif;
  }
  .btn-preparado:hover{background:var(--pine-soft);}
  .btn-preparado:disabled{background:var(--pine-soft);opacity:.7;cursor:default;}

  .empty-principal{text-align:center;color:var(--ink-soft);font-size:19px;padding:30px 10px;font-family:'Fraunces',serif;}

  /* Segunda tarjeta: después */
  .despues{
    background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
    padding:18px 20px;
  }
  .despues .etiqueta{
    font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;
    color:var(--ink-soft);font-weight:700;margin-bottom:4px;display:flex;justify-content:space-between;
  }
  .despues .hora{color:var(--pine-soft);}
  .despues dl{display:grid;grid-template-columns:auto 1fr;gap:4px 14px;margin:10px 0 10px;}
  .despues dt{font-size:11.5px;text-transform:uppercase;letter-spacing:.05em;color:var(--ink-soft);font-weight:700;align-self:start;padding-top:2px;}
  .despues dd{margin:0;font-size:16px;font-weight:600;color:var(--ink);}
  .despues .equipos-simple{font-size:14px;color:var(--ink-soft);}

  footer{text-align:center;color:var(--ink-soft);font-size:11.5px;margin-top:26px;}

  @media (max-width:400px){
    .principal dl, .despues dl{grid-template-columns:1fr;}
    .principal dt, .despues dt{padding-top:0;margin-top:6px;}
  }
</style>
</head>
<body>
<div class="wrap">

  <header>
    <p class="brand-eyebrow">Referente de Informática</p>
    <h1>Preparación de equipos</h1>
    <div class="reloj" id="reloj"></div>
  </header>

  <div class="principal" id="principal">
    <div id="principalContenido" class="empty-principal">Cargando información…</div>
  </div>

  <div class="despues" id="despuesCard" style="display:none;">
    <div id="despuesContenido"></div>
  </div>

  <footer>Se actualiza solo cada 30 segundos. No modifica las reservas.</footer>
</div>

<script>
/* ============================================================
   Asistente de Preparación de Equipos — página independiente
   y de solo lectura para el referente de informática.

   Reutiliza la MISMA Google Sheet y el MISMO Apps Script que
   reservas-edutec.html (acción "list", ya existente). No se
   agregó ninguna acción nueva en el backend para esta página.
   ============================================================ */

const APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbxX0mQaRSl_1ddKLwCg1NQYiAceriqDm9mVx9JHjXlM8_SDdOfLbR7o9LfmJU0pLqfm/exec';

const SLOTS = ['7:30','8:10','9:00','9:40','10:30','11:10','11:40','12:20'];

const NOMBRES_EQUIPO = {
  proyector: 'Proyector',
  televisor: 'Televisor',
  pc_docente: 'PC Docente',
  pizarra: 'Pizarra digital',
};

// Checklist manual del referente: no se guarda en Sheets, solo ayuda a no
// olvidarse de pasos. Se reinicia solo cuando cambia la reserva destacada.
const CHECKLIST_ITEMS = [
  'Netbooks retiradas del carro',
  'Proyector conectado',
  'PC docente encendida',
  'Equipos entregados',
];

let reservas = [];
let ultimaSituacion = null;

const notifState = {};      // { [reservaId]: {min15:bool, min5:bool, inicio:bool, fin:bool} }
const checklistState = {};  // { [reservaId]: Set(indices marcados) }
const preparadoState = {};  // { [reservaId]: bool }

/* ---------- utilidades de fecha/hora ---------- */
function todayStr(){
  const d = new Date();
  return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
}
function horaAFecha(fechaStr, horaStr){
  const [y,m,d] = fechaStr.split('-').map(Number);
  const [hh,mm] = horaStr.split(':').map(Number);
  return new Date(y, m-1, d, hh, mm, 0, 0);
}
function fmtHoraCorta(horaStr){
  const [hh,mm] = horaStr.split(':');
  return String(hh).padStart(2,'0')+':'+mm;
}

/* ---------- resumen de equipos ---------- */
function contarEquipos(items){
  const netbooks = items.filter(it => it.grupo === 'carrito_netbooks' || it.grupo === 'sueltas_netbooks').length;
  const extras = {};
  items
    .filter(it => it.grupo !== 'carrito_netbooks' && it.grupo !== 'sueltas_netbooks')
    .forEach(it => { extras[it.grupo] = (extras[it.grupo] || 0) + 1; });

  const partes = [];
  if(netbooks > 0) partes.push(`${netbooks} Netbook${netbooks > 1 ? 's' : ''}`);
  Object.entries(extras).forEach(([id, cant]) => {
    const nombre = NOMBRES_EQUIPO[id] || id;
    partes.push(cant > 1 ? `${cant} ${nombre}s` : nombre);
  });
  return partes.length ? partes : ['Sin equipos'];
}
function resumenEquiposConCheck(items){
  return contarEquipos(items).map(txt => `✔ ${txt}`);
}

/* ---------- carga de datos (misma acción "list" que ya existe) ---------- */
let cargoAlgunaVez = false; // true apenas la primera carga funciona correctamente

async function cargarReservas(){
  const res = await fetch(`${APPS_SCRIPT_URL}?action=list`);
  const data = await res.json();
  if(data.error) throw new Error(data.error);
 reservas = (data.reservas || []).map(r => ({
  ...r,
  fecha: String(r.fecha).substring(0,10),
  retiroIdx: Number(r.retiroIdx),
  devolIdx: Number(r.devolIdx),
}));
  cargoAlgunaVez = true;
}

/* ---------- cálculo de la situación actual ---------- */
function reservasDeHoyOrdenadas(){
  const hoy = todayStr();
  return reservas
    .filter(r => r.fecha === hoy)
    .map(r => ({
      ...r,
      inicio: horaAFecha(hoy, SLOTS[r.retiroIdx]),
      fin: horaAFecha(hoy, SLOTS[r.devolIdx]),
    }))
    .sort((a,b) => a.inicio - b.inicio);
}

function calcularSituacion(){
  const ahora = new Date();
  const hoy = reservasDeHoyOrdenadas();
  // "principal" = la primera reserva de hoy que todavía no terminó (en curso o futura)
  const pendientes = hoy.filter(r => r.fin > ahora);
  const principal = pendientes[0] || null;
  const despues = pendientes[1] || null;
  return { ahora, principal, despues };
}

/* ---------- render: tarjeta principal ---------- */
function renderPrincipal(sit){
  const cont = document.getElementById('principal');
  const inner = document.getElementById('principalContenido');
  const r = sit.principal;

  if(!r){
    cont.className = 'principal';
    inner.className = 'empty-principal';
    inner.innerHTML = 'No hay más entregas programadas para hoy.';
    return;
  }

  const enCurso = sit.ahora >= r.inicio;
  const yaPreparado = !!preparadoState[r.id];

  let colorClase, etiquetaContador, numero, unidadTxt;
  if(yaPreparado){
    colorClase = 'verde';
  } else if(enCurso){
    colorClase = 'rojo';
  } else {
    const minInicio = Math.ceil((r.inicio - sit.ahora) / 60000);
    colorClase = minInicio <= 5 ? 'naranja' : (minInicio <= 15 ? 'amarillo' : '');
  }

  if(enCurso){
    const minFin = Math.max(0, Math.ceil((r.fin - sit.ahora) / 60000));
    etiquetaContador = 'En curso';
    numero = minFin;
    unidadTxt = `minuto${minFin === 1 ? '' : 's'} para retirar equipos`;
  } else {
    const minInicio = Math.max(0, Math.ceil((r.inicio - sit.ahora) / 60000));
    etiquetaContador = 'Comienza en';
    numero = minInicio;
    unidadTxt = `minuto${minInicio === 1 ? '' : 's'}`;
  }

  const equipos = resumenEquiposConCheck(r.items);
  if(!checklistState[r.id]) checklistState[r.id] = new Set();
  const marcados = checklistState[r.id];

  const checklistHtml = CHECKLIST_ITEMS.map((texto, i) => {
    const marcado = marcados.has(i);
    return `
      <label class="check-item ${marcado ? 'marcado' : ''}">
        <input type="checkbox" data-idx="${i}" ${marcado ? 'checked' : ''}>
        <span>${texto}</span>
      </label>`;
  }).join('');

  const confirmacionHtml = yaPreparado
    ? `<div class="confirmacion-preparado">Equipos preparados. Esperando al profesor.</div>`
    : '';

  const botonHtml = yaPreparado
    ? `<button type="button" class="btn-preparado" disabled>✔ Equipos preparados</button>`
    : `<button type="button" class="btn-preparado" id="btnEquiposPreparados">✓ Equipos preparados</button>`;

  cont.className = 'principal' + (colorClase ? ' ' + colorClase : '');
  inner.className = '';
  inner.innerHTML = `
    <div class="etiqueta">Próxima entrega</div>
    <dl>
      <dt>Profesor</dt><dd>${r.nombre}</dd>
      <dt>Curso</dt><dd>${r.materia}</dd>
      <dt>Horario</dt><dd>${fmtHoraCorta(SLOTS[r.retiroIdx])} - ${fmtHoraCorta(SLOTS[r.devolIdx])}</dd>
    </dl>
    <div class="contador">
      <div class="etiqueta-contador">${etiquetaContador}</div>
      <div class="num">${numero}</div>
      <div class="unidad">${unidadTxt}</div>
    </div>
    <div class="preparar-titulo">Preparar</div>
    <ul class="preparar-lista">${equipos.map(e => `<li>${e}</li>`).join('')}</ul>
    <div class="preparacion-box">
      <div class="preparar-titulo">Preparación</div>
      ${checklistHtml}
    </div>
    ${confirmacionHtml}
    ${botonHtml}
  `;

  if(!yaPreparado){
    document.getElementById('btnEquiposPreparados').addEventListener('click', () => {
      preparadoState[r.id] = true;
      renderPrincipal(ultimaSituacion);
    });
  }
  inner.querySelectorAll('.check-item input').forEach(chk => {
    chk.addEventListener('change', () => {
      const idx = Number(chk.getAttribute('data-idx'));
      if(chk.checked) marcados.add(idx); else marcados.delete(idx);
      renderPrincipal(ultimaSituacion);
    });
  });
}

/* ---------- render: segunda tarjeta (después) ---------- */
function renderDespues(sit){
  const card = document.getElementById('despuesCard');
  const inner = document.getElementById('despuesContenido');
  const r = sit.despues;

  if(!r){
    card.style.display = 'none';
    return;
  }
  card.style.display = 'block';

  const equipos = contarEquipos(r.items).join(', ');
  inner.innerHTML = `
    <div class="etiqueta"><span>Después</span><span class="hora">${fmtHoraCorta(SLOTS[r.retiroIdx])}</span></div>
    <dl>
      <dt>Profesor</dt><dd>${r.nombre}</dd>
    </dl>
    <div class="preparar-titulo">Preparar</div>
    <div class="equipos-simple">${equipos}</div>
  `;
}

/* ---------- reloj (orientación simple, no es un panel de estado) ---------- */
function renderReloj(){
  const ahora = new Date();
  const hh = String(ahora.getHours()).padStart(2,'0');
  const mm = String(ahora.getMinutes()).padStart(2,'0');
  const dd = String(ahora.getDate()).padStart(2,'0');
  const mo = String(ahora.getMonth()+1).padStart(2,'0');
  const yy = ahora.getFullYear();
  document.getElementById('reloj').textContent = `${dd}/${mo}/${yy} — ${hh}:${mm}`;
}

/* ============================================================
   NOTIFICACIONES
   Arquitectura pensada para poder sumar Telegram más adelante
   sin reescribir el resto de la app:

   - construirMensaje(evento, reserva)  -> arma {titulo, cuerpo}
     para cada evento (min15, min5, inicio, fin). Es el único
     lugar donde vive el TEXTO de cada notificación.

   - CANALES_NOTIFICACION es un arreglo de funciones. Cada una
     recibe el mensaje ya armado y lo entrega por un medio
     distinto. Hoy solo está activo el navegador.

   - Para agregar Telegram en el futuro:
       1) Crear una función enviarNotificacionTelegram(mensaje)
          que llame a un endpoint propio (por ejemplo, otra
          acción de Apps Script) que reenvíe el mensaje a la
          Bot API de Telegram.
       2) Agregar esa función a CANALES_NOTIFICACION (más abajo
          hay una línea comentada lista para descomentar).
     No hace falta tocar dispararNotificacion, construirMensaje
     ni el resto del código del panel.
   ============================================================ */

function construirMensaje(evento, reserva){
  const equipos = resumenEquiposConCheck(reserva.items).join('\n');
  switch(evento){
    case 'min15':
      return { titulo: '🔔 Próxima entrega', cuerpo: `${reserva.nombre}\n${reserva.materia}\n\n${equipos}` };
    case 'min5':
      return { titulo: '🔔 Comienza en 5 minutos', cuerpo: `${reserva.nombre}\n${reserva.materia}\n\n${equipos}` };
    case 'inicio':
      return { titulo: 'Sala de Computación', cuerpo: 'La reserva comenzó.' };
    case 'fin':
      return { titulo: 'Sala de Computación', cuerpo: 'La reserva finalizó.\nRetirar equipos.' };
    default:
      return { titulo: 'Sala de Computación', cuerpo: '' };
  }
}

function enviarNotificacionNavegador(mensaje){
  if('Notification' in window && Notification.permission === 'granted'){
    new Notification(mensaje.titulo, { body: mensaje.cuerpo });
  }
}

// function enviarNotificacionTelegram(mensaje){
//   // TODO (futuro): reenviar `mensaje` a un bot de Telegram, por ejemplo:
//   // fetch(TELEGRAM_BRIDGE_URL, { method: 'POST', body: JSON.stringify(mensaje) });
// }

const CANALES_NOTIFICACION = [
  enviarNotificacionNavegador,
  // enviarNotificacionTelegram, // <- descomentar cuando esté implementado
];

function dispararNotificacion(evento, reserva){
  const mensaje = construirMensaje(evento, reserva);
  CANALES_NOTIFICACION.forEach(canal => canal(mensaje));
}

function pedirPermisoNotificaciones(){
  if('Notification' in window && Notification.permission === 'default'){
    Notification.requestPermission();
  }
}

/* ---------- sonidos cortos (sin archivos externos), uno por evento ---------- */
let audioCtx = null;
function beep(frecuencia, duracionMs){
  try{
    audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = 'sine';
    osc.frequency.value = frecuencia;
    gain.gain.value = 0.15;
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start();
    setTimeout(() => { osc.stop(); }, duracionMs);
  }catch(e){ /* algunos navegadores requieren una interacción previa; se ignora si falla */ }
}
function reproducirSonido(evento){
  switch(evento){
    case 'min15': beep(880, 250); break;
    case 'min5':  beep(660, 350); break;
    case 'inicio': beep(520, 300); break;
    case 'fin':   beep(320, 400); break;
  }
}

/* ---------- disparo de eventos según el tiempo restante (una sola vez cada uno) ---------- */
function procesarNotificaciones(sit){
  const r = sit.principal;
  if(!r) return;
  if(!notifState[r.id]) notifState[r.id] = { min15:false, min5:false, inicio:false, fin:false };
  const st = notifState[r.id];

  const minInicio = (r.inicio - sit.ahora) / 60000;
  const minFin = (r.fin - sit.ahora) / 60000;

  if(!st.min15 && minInicio <= 15 && minInicio > 5){
    dispararNotificacion('min15', r);
    reproducirSonido('min15');
    st.min15 = true;
  }
  if(!st.min5 && minInicio <= 5 && minInicio > 0){
    dispararNotificacion('min5', r);
    reproducirSonido('min5');
    st.min5 = true;
  }
  if(!st.inicio && minInicio <= 0 && minFin > 0){
    dispararNotificacion('inicio', r);
    reproducirSonido('inicio');
    st.inicio = true;
  }
  if(!st.fin && minFin <= 0){
    dispararNotificacion('fin', r);
    reproducirSonido('fin');
    st.fin = true;
  }
}

/* ---------- ciclo principal: actualiza todo cada 30s, sin recargar ---------- */
async function actualizarTodo(){
  try{
    await cargarReservas();
  }catch(e){
    if(!cargoAlgunaVez){
      // Nunca se pudo conectar: mostrarlo en vez de confundirlo con "no hay reservas"
      const inner = document.getElementById('principalContenido');
      document.getElementById('principal').className = 'principal';
      inner.className = 'empty-principal';
      inner.innerHTML = 'No se pudo conectar con la planilla.<br><small style="font-size:14px;">Se reintenta automáticamente cada 30 segundos.</small>';
    }
    // Si ya había datos buenos, se dejan en pantalla tal cual y se reintenta en el próximo ciclo
    return;
  }

  const sit = calcularSituacion();
  ultimaSituacion = sit;
  renderPrincipal(sit);
  renderDespues(sit);
  procesarNotificaciones(sit);
}

function init(){
  pedirPermisoNotificaciones();
  renderReloj();
  setInterval(renderReloj, 30000);

  actualizarTodo();
  setInterval(actualizarTodo, 30000);
}

init();
</script>
</body>
</html>
